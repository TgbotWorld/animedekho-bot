# ── Telegram API Credentials ──────────────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Bot Owner & Admins ────────────────────────────────────────────────
OWNER_ID=123456789
ADMINS=

# ── Telegram Channels ────────────────────────────────────────────────
MAIN_CHANNEL=-1001234567890
LOG_CHANNEL=-1001234567890
DUMP_CHANNEL=0
FSUB_CHANNEL=

# ── Database (MongoDB) ────────────────────────────────────────────────
# For external/cloud MongoDB (e.g. MongoDB Atlas or existing VPS database),
# set your connection string below. The Docker 'mongo' container will NOT run.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
#
# If you do NOT have an external MongoDB and want Docker to run local MongoDB:
# uncomment COMPOSE_PROFILES=mongo (or run: docker compose --profile mongo up -d)
# COMPOSE_PROFILES=mongo
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=animedekho_bot

# ── Default Fallback Thumbnails (Issue #9) ───────────────────────────
DEFAULT_ANIME_THUMB=https://images.unsplash.com/photo-1578632767115-351597cf2477?w=1000
DEFAULT_MOVIE_THUMB=https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1000

# ── Features & Security ───────────────────────────────────────────────
AUTO_SEARCH=on
AUTO_THUMB=on
AUTO_SCHEDULE_POST=off
AUTO_DELETE_TIME=600
FSUB_MOD=on

# ── UI Styles: modern-only since V3 #7 (legacy 'classic' auto-migrates) ─
START_STYLE=modern
SCHED_STYLE=modern
EP_STYLE=modern
POST_STYLE=modern
START_PIC=
FSUB_PIC=

# ── DGT Ad-Gate Unlock (2026-10 site upgrade) ─────────────────────────
# The site now gates /wp-json/dgt/v1/watch behind an ad-verification step.
# When a gate is detected, the bot clears it in a real (non-headless) Chromium
# via Playwright. Requires xvfb + `playwright install chromium` (both in the
# Dockerfile). Set to 'off' to disable browser unlocking entirely.
DGT_GATE_BROWSER=auto
# Seconds to wait for the gate's server-side timer (too-early verify => 403).
DGT_GATE_WAIT=42
# Hard ceiling for one unlock attempt.
DGT_GATE_TIMEOUT=150

# ── Source Domain Overrides (optional) ────────────────────────────────
# Scraper sites rotate domains without notice. The bot auto-detects the
# live domain at runtime (probes known mirrors, follows redirects, rejects
# parked/squatted hosts). Set one of these ONLY to pin a specific origin.
#   ANIMEDEKHO_BASE_URL=https://animedekho.tv
#   TOONFLIX_BASE_URL=https://toonflix.in
#   ANIMEDRIVE_BASE_URL=https://animedrive.cc
#   TOONANIME_BASE_URL=https://toonanime.biz
#   TOONO_BASE_URL=https://toono.app
#   RAREANIMES_BASE_URL=https://www.rareanimes.mov
#   DEADTOONS_BASE_URL=https://deadtoons.sbs
#   TOONWORLD4ALL_BASE_URL=https://toonworld4all.me
#   ANIMEDUBHINDI_BASE_URL=https://www.animedubhindi.link

# ── Autonomous AI Agent ───────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_ENABLED=true

# ── System ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
